<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- Cam 1 Container -->
    <FrameLayout
        android:id="@+id/containerCam1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/containerCam2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 藍色底圖 (TextureView 模式下的藍屏) -->
        <View
            android:id="@+id/bgBlueCam1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#002266" />

        <!-- Video Container for dynamic player injection -->
        <FrameLayout
            android:id="@+id/videoContainerCam1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- 專業 OSD 頂部資訊列 (加入更大 Padding 避開 Pixel 10 挖孔) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#60000000"
            android:orientation="horizontal"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/tvStatusCam1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● OFFLINE"
                android:textColor="#FF0000"
                android:textSize="11sp"
                android:textStyle="bold" />
            <View android:layout_width="8dp" android:layout_height="1dp" />
            <TextView
                android:id="@+id/tvNameCam1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CAM 01"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="end" />
        </LinearLayout>

        <!-- 專業 OSD 底部數據列 (加入更大 Padding) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#60000000"
            android:orientation="vertical"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:paddingBottom="8dp">
            <TextView
                android:id="@+id/tvProtocolCam1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="CTRL: VISCA/UDP:52381"
                android:textColor="#AAAAAA"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/tvStreamCam1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="STRM: RTSP/TCP:554"
                android:textColor="#AAAAAA"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/tvDataCam1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="---"
                android:textColor="#00FF00"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Preset 快捷鍵 (在中央分界處) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:orientation="vertical"
            android:padding="2dp">
            <Button
                android:id="@+id/btnP1Cam1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="P1"
                android:textSize="10sp"
                android:padding="0dp"
                android:alpha="0.6"
                android:backgroundTint="#444444" />
            <Button
                android:id="@+id/btnP2Cam1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="P2"
                android:textSize="10sp"
                android:padding="0dp"
                android:alpha="0.6"
                android:backgroundTint="#444444"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Cam 2 Container -->
    <FrameLayout
        android:id="@+id/containerCam2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/containerCam1"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 藍色底圖 -->
        <View
            android:id="@+id/bgBlueCam2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#002266" />

        <!-- Video Container for dynamic player injection -->
        <FrameLayout
            android:id="@+id/videoContainerCam2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- 專業 OSD 頂部資訊列 (加入更大 Padding 避開 Pixel 10 挖孔) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#60000000"
            android:orientation="horizontal"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/tvStatusCam2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● OFFLINE"
                android:textColor="#FF0000"
                android:textSize="11sp"
                android:textStyle="bold" />
            <View android:layout_width="8dp" android:layout_height="1dp" />
            <TextView
                android:id="@+id/tvNameCam2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CAM 02"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="end" />
        </LinearLayout>

        <!-- 專業 OSD 底部數據列 (加入更大 Padding) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#60000000"
            android:orientation="vertical"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:paddingBottom="8dp">
            <TextView
                android:id="@+id/tvProtocolCam2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="CTRL: VISCA/UDP:52381"
                android:textColor="#AAAAAA"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/tvStreamCam2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="STRM: RTSP/TCP:554"
                android:textColor="#AAAAAA"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/tvDataCam2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="---"
                android:textColor="#00FF00"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Preset 快捷鍵 (在中央分界處) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:orientation="vertical"
            android:padding="2dp">
            <Button
                android:id="@+id/btnP1Cam2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="P1"
                android:textSize="10sp"
                android:padding="0dp"
                android:alpha="0.6"
                android:backgroundTint="#444444" />
            <Button
                android:id="@+id/btnP2Cam2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="P2"
                android:textSize="10sp"
                android:padding="0dp"
                android:alpha="0.6"
                android:backgroundTint="#444444"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Settings Button -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Settings"
        android:src="@android:drawable/ic_menu_preferences"
        android:alpha="0.5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.horizon.horizonptz.ui.VirtualJoystickView
        android:id="@+id/joystickCam1"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_margin="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.horizon.horizonptz.ui.VirtualJoystickView
        android:id="@+id/joystickCam2"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_margin="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
